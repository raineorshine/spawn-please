{
  "name": "spawn-please",
  "version": "3.0.0",
  "description": "Easy and small child_process.spawn",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raineorshine/spawn-please.git"
  },
  "author": "Raine Revere (https://github.com/raineorshine)",
  "bugs": {
    "url": "https://github.com/raineorshine/spawn-please/issues"
  },

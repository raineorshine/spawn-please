{
  "name": "spawn-please",
  "version": "4.0.0",
  "description": "Easy and small child_process.spawn",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raineorshine/spawn-please.git"
  },
  "author": "Raine Revere (https://github.com/raineorshine)",
  "bugs": {
    "url": "https://github.com/raineorshine/spawn-please/issues"
  },
  "homepage": "https://github.com/raineorshine/spawn-please#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "keywords": [
    "promise",
    "promisified",
    "child_process",
    "child process",
    "exec",
    "spawn",
    "stdin",
    "stdout",
    "stderr"
  ],
  "files": [
    "src",
    "types",
    "!**/test/**"
  ],
  "scripts": {
    "build": "tsc && prettier --write types",
    "lint": "prettier --check . && tsc -p tsconfig.lint.json",
    "lintfix": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
